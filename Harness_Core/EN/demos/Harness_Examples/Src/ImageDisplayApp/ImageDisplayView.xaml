<Window x:Class="Philips.CT.Host.ImageDisplay.Shell.ImageDisplayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Philips.CT.Host.ImageDisplay.Shell"
        Title="CT Image Display — Window/Level Reset Demo"
        Height="560" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">

    <Window.Resources>
        <shell:WindowCenterToBrushConverter x:Key="WcToBrush" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl+Shift" Key="W" Command="{Binding ResetWindowLevelCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- Status bar (bound to the notifier via the window's Status property) -->
        <Border DockPanel.Dock="Bottom" Background="#FF007ACC" MinHeight="30">
            <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="White" FontSize="13"
                       AutomationProperties.AutomationId="StatusBarMessage"
                       Text="{Binding Status.Message, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Border>

        <!-- Right-hand control panel -->
        <Border DockPanel.Dock="Right" Width="280" Background="#FF252526" Padding="18">
            <StackPanel>
                <TextBlock Text="Window / Level" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

                <TextBlock Text="Window Width (WW)" Foreground="#FFBFBFBF" FontSize="12" />
                <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="WindowWidthValue"
                           Text="{Binding WindowWidth, StringFormat=N0}" />
                <Slider Minimum="1" Maximum="4000" Margin="0,4,0,14"
                        AutomationProperties.AutomationId="WindowWidthSlider"
                        Value="{Binding WindowWidth, Mode=TwoWay}" />

                <TextBlock Text="Window Center (WC)" Foreground="#FFBFBFBF" FontSize="12" />
                <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="WindowCenterValue"
                           Text="{Binding WindowCenter, StringFormat=N0}" />
                <Slider Minimum="-1000" Maximum="3000" Margin="0,4,0,20"
                        AutomationProperties.AutomationId="WindowCenterSlider"
                        Value="{Binding WindowCenter, Mode=TwoWay}" />

                <Button Content="Reset W/L  (Ctrl+Shift+W)" Height="42" FontSize="14" Margin="0,0,0,12"
                        AutomationProperties.AutomationId="ResetWindowLevelButton"
                        Command="{Binding ResetWindowLevelCommand}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <Button Content="Undo" Width="118" Height="34" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="UndoButton"
                            Command="{Binding UndoCommand}" />
                    <Button Content="Redo" Width="118" Height="34"
                            AutomationProperties.AutomationId="RedoButton"
                            Command="{Binding RedoCommand}" />
                </StackPanel>

                <TextBlock Margin="0,18,0,0" Foreground="#FF808080" FontSize="12" TextWrapping="Wrap"
                           Text="Drag a slider to adjust the display, then Reset to restore the DICOM default (or fallback if the series has no windowing tags)." />
            </StackPanel>
        </Border>

        <!-- Image viewport: brightness reacts to Window Center so the reset is visible -->
        <Border Margin="18" CornerRadius="4" BorderBrush="#FF3F3F46" BorderThickness="1"
                AutomationProperties.AutomationId="ImageViewport"
                Background="{Binding WindowCenter, Converter={StaticResource WcToBrush}}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="30" FontWeight="SemiBold" Foreground="#66FFFFFF">
                <TextBlock.Text>
                    <MultiBinding StringFormat="WW {0:N0}   /   WC {1:N0}">
                        <Binding Path="WindowWidth" />
                        <Binding Path="WindowCenter" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>

    </DockPanel>
</Window>
